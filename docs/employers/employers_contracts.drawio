<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram name="Employers — входные и выходные данные"><mxGraphModel dx="1500" dy="1000" grid="1" page="1" pageWidth="1500" pageHeight="1220"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="GET /employers/&#10;Вход: query, role, is_active, sort_by, order&#10;Выход 200: массив EmployerResponse&#10;Поиск по ФИО/логину; asc или desc" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f7fa;strokeColor=#8994a4;fontSize=20;" vertex="1" parent="1"><mxGeometry x="45" y="110" width="690" height="230" as="geometry" /></mxCell><mxCell id="3" value="GET /employers/search&#10;Вход: обязательный query, 1–150 символов&#10;Выход 200: массив найденных карточек&#10;Пустой запрос → 422" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f7fa;strokeColor=#8994a4;fontSize=20;" vertex="1" parent="1"><mxGeometry x="770" y="110" width="690" height="230" as="geometry" /></mxCell><mxCell id="4" value="GET /employers/{employer_id}&#10;Вход: employer_id — целое число в пути&#10;Выход 200: EmployerResponse&#10;Карточка не найдена → 404" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f7fa;strokeColor=#8994a4;fontSize=20;" vertex="1" parent="1"><mxGeometry x="45" y="375" width="690" height="230" as="geometry" /></mxCell><mxCell id="5" value="POST /employers/&#10;JSON: username, full_name, role&#10;Выход 201: EmployerResponse, ACTIVE&#10;Повтор логина → 409; ошибки полей → 422" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f7fa;strokeColor=#8994a4;fontSize=20;" vertex="1" parent="1"><mxGeometry x="770" y="375" width="690" height="230" as="geometry" /></mxCell><mxCell id="6" value="PUT /employers/{employer_id}&#10;Путь: employer_id; JSON: full_name, role&#10;Выход 200: изменённая карточка&#10;Хотя бы одно поле; пустой JSON → 422" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f7fa;strokeColor=#8994a4;fontSize=20;" vertex="1" parent="1"><mxGeometry x="45" y="640" width="690" height="230" as="geometry" /></mxCell><mxCell id="7" value="PATCH /employers/{id}/status&#10;Путь: id; JSON: is_active&#10;Допустимы только ACTIVE и BLOCKED&#10;Выход 200: обновлённая карточка" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f7fa;strokeColor=#8994a4;fontSize=20;" vertex="1" parent="1"><mxGeometry x="770" y="640" width="690" height="230" as="geometry" /></mxCell><mxCell id="8" value="DELETE /employers/{employer_id}&#10;Вход: employer_id; тело не передаётся&#10;Только BLOCKED; иначе 409&#10;Выход 204 без тела; нет записи → 404" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f7fa;strokeColor=#8994a4;fontSize=20;" vertex="1" parent="1"><mxGeometry x="45" y="905" width="690" height="230" as="geometry" /></mxCell><mxCell id="9" value="Общий контракт и доступ&#10;Authorization: Bearer &lt;JWT&gt;, роль ADMIN&#10;Response: id, username, full_name,&#10;role, is_active; нет входа 401, нет прав 403" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f7fa;strokeColor=#8994a4;fontSize=20;" vertex="1" parent="1"><mxGeometry x="770" y="905" width="690" height="230" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>